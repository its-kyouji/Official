  "outbounds": [
    // ==== DIRECT & BLOCK ====
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    },
    // ==== CHAIN OUTBOUNDS ====
    {
      "tag": "chain-vless",
      "protocol": "vless",
      "settings": {
        "vnext": [{"address": "127.0.0.1", "port": 443, "users": [{"id": "UUID_PLACEHOLDER", "encryption": "none"}]}]
      },
      "streamSettings": {
        "network": "ws", "security": "tls", "tlsSettings": {"allowInsecure": false}, "wsSettings": {"path": "/"}
      }
    },
    {
      "tag": "chain-vmess",
      "protocol": "vmess",
      "settings": {
        "vnext": [{"address": "127.0.0.1", "port": 443, "users": [{"id": "UUID_PLACEHOLDER", "alterId": 0}]}]
