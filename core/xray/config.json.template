      "streamSettings": {
        "network": "ws", "security": "tls", "tlsSettings": {"allowInsecure": false}, "wsSettings": {"path": "/"}
      }
    },
    {
      "tag": "chain-trojan",
      "protocol": "trojan",
      "settings": {
        "servers": [{"address": "127.0.0.1", "port": 443, "password": "PASS_PLACEHOLDER"}]
      },
      "streamSettings": {
        "network": "ws", "security": "tls", "tlsSettings": {"allowInsecure": false}, "wsSettings": {"path": "/"}
      }
