{
  "dns": {
    "servers": [
      {
        "tag": "cloudflare",
        "type": "https",
        "server": "cloudflare-dns.com"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "dns.google"
      },
      {
        "tag": "local",
        "type": "udp",
        "server": "1.1.1.1",
        "detour": "direct"
      }
    ],
    "rules": [
      {
        "outbound": "any",
        "server": "local"
      },
      {
        "geosite": ["category-ads-all"],
        "action": "reject",
        "method": "default"
      }
    ]
  }
}
