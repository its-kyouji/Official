{
    admin off
    auto_https off
    servers {
        protocols h1 h2c
    }
}

:8084 {
    handle /health {
        respond "OK" 200
    }

    @xvless { path_regexp .*-x-vless-xh$ }
    handle @xvless { reverse_proxy 127.0.0.1:10003 { flush_interval -1 transport http { versions h1 h2c 2 } } }

    @xvmess { path_regexp .*-x-vmess-xh$ }
    handle @xvmess { reverse_proxy 127.0.0.1:10007 { flush_interval -1 transport http { versions h1 h2c 2 } } }

    @xtrojan { path_regexp .*-x-trojan-xh$ }
    handle @xtrojan { reverse_proxy 127.0.0.1:10011 { flush_interval -1 transport http { versions h1 h2c 2 } } }

    @xss { path_regexp .*-x-ss-xh$ }
    handle @xss { reverse_proxy 127.0.0.1:10015 { flush_interval -1 transport http { versions h1 h2c 2 } } }

    handle {
        root * /app/panel
        file_server
    }
}
