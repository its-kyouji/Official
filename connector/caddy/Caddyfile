{
    admin off

    servers {
        protocols h1 h2c
    }
}

:8084 {
    # ==== XRAY XHTTP ====

    handle /kyouji/kyouji-x-vless-xh* {
        reverse_proxy 127.0.0.1:10003 {
            flush_interval -1
        }
    }

    handle /kyouji/kyouji-x-vmess-xh* {
        reverse_proxy 127.0.0.1:10007 {
            flush_interval -1
        }
    }

    handle /kyouji/kyouji-x-trojan-xh* {
        reverse_proxy 127.0.0.1:10011 {
            flush_interval -1
        }
    }

    handle /kyouji/kyouji-x-ss-xh* {
        reverse_proxy 127.0.0.1:10015 {
            flush_interval -1
        }
    }

    # ==== DEFAULT DENY ====

    respond 404
}
